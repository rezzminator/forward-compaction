{
  "autoCompactEnabled": true,
  "autoMemoryEnabled": false,
  "autoContinueAtUsageLimit": false,
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "100000",
    "FORWARD_COMPACTION_MAIN_CEILING": "100000",
    "FORWARD_COMPACTION_SUBAGENT_CEILING": "100000"
  },
  "permissions": {
    "allow": [
      "Agent",
      "Read",
      "Bash",
      "Skill",
      "SendMessage",
      "mcp__forward-compaction__*"
    ],
    "defaultMode": "dontAsk"
  }
}
